name: Deploy Azure Resource & Function(s)
on:
  push:
    branches:
      - main

env:
  LOCATION: southafricanorth
  RESOURCE_GROUP: rg-functiontemplate
  AZURE_FUNCTIOAPP_NAME: "the function app name"

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v6

      - name: Login to Azure
        uses: azure/login@v3
        with:
          creds: ${{ secrets.AZURE_CREDENTIALS }}

      - name: Install / Upgrade Bicep
        run: |
          az bicep install
          az bicep upgrade

      - name: Create Resource Group
        run: |
          az group create --name ${{ env.RESOURCE_GROUP }} --location ${{ env.LOCATION }}

      - name: Deploy Bicep Script
        uses: azure/arm-deploy@v2
        with:
          scope: resourcegroup
          resourceGroupName: ${{ env.RESOURCE_GROUP }}
          template: infra/main.bicep

      - name: Set up node.js environment
        uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: pnpm

      - name: Install dependencies and build TypeScript
        run: |
          npm ci
          npm run build

      - name: Deploy Azure Function App
        uses: azure/functions-action@v1
        with:
          app-name: ${{ env.AZURE_FUNCTIOAPP_NAME }}
          package: "dist/"

      - name: Deployment Successful
        run: |
            echo "Infrastructure and function code deployment completed Successfully"